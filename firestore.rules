rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    match /admins/{uid} {
      allow get: if request.auth != null && request.auth.uid == uid;
      allow write, list: if false;
    }
    match /products/{id} {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasAll(['name', 'category', 'price', 'image'])
        && request.resource.data.keys().hasOnly(['name', 'category', 'price', 'image'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.category in ['Men', 'Women']
        && request.resource.data.price is number
        && request.resource.data.price > 0 && request.resource.data.price <= 1000000
        && request.resource.data.image is string && request.resource.data.image.size() <= 2048
        && request.resource.data.image.matches('^(https://[^\\s]+|assets/[a-zA-Z0-9_.-]+)$');
    }
    match /orders/{id} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasAll(['firstName', 'lastName', 'email', 'contactNumber', 'address', 'items', 'total', 'status', 'createdAt'])
        && request.resource.data.keys().hasOnly(['firstName', 'lastName', 'email', 'contactNumber', 'address', 'items', 'total', 'status', 'createdAt'])
        && request.resource.data.firstName is string && request.resource.data.firstName.size() > 0 && request.resource.data.firstName.size() <= 300
        && request.resource.data.lastName is string && request.resource.data.lastName.size() > 0 && request.resource.data.lastName.size() <= 300
        && request.resource.data.email is string && request.resource.data.email.size() > 0 && request.resource.data.email.size() <= 300
        && request.resource.data.contactNumber is string && request.resource.data.contactNumber.size() > 0 && request.resource.data.contactNumber.size() <= 300
        && request.resource.data.address is string && request.resource.data.address.size() > 0 && request.resource.data.address.size() <= 300
        && request.resource.data.items is list && request.resource.data.items.size() > 0 && request.resource.data.items.size() <= 100
        && request.resource.data.total is number && request.resource.data.total > 0
        && request.resource.data.status == 'New'
        && request.resource.data.createdAt == request.time;
    }
  }
}
